\newcommand{\brackets}[4][a]{%
  \ifx a#1\left#2 #3 \right#4\else
  \ifx s#1#2 #3 #4\else
  \ifx b#1\big#2 #3 \big#4\else
  \ifthenelse{\equal{#1}{B}} {\Big#2 #3 \Big#4} {}
  \ifthenelse{\equal{#1}{Bg}} {\Bigg#2 #3 \Bigg#4} {}
  \fi\fi\fi
}

\newcommand{\br}[2][a]{\brackets[#1]{(}{#2}{)}}
\newcommand{\cbr}[2][a]{\brackets[#1]{\{}{#2}{\}}}
\newcommand{\sbr}[2][a]{\brackets[#1]{[}{#2}{]}}
\newcommand{\abr}[2][a]{\brackets[#1]{\langle}{#2}{\rangle}}
\newcommand{\av}[2][a]{\brackets[#1]{|}{#2}{|}}
\newcommand{\norm}[2][a]{\brackets[#1]{\|}{#2}{\|}}


\newcommand{\ifrac}[2]{#1 / #2}


