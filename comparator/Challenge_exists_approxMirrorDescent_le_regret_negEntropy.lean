  /-- The step lies in `K`. -/
  mem : x ∈ K
  /-- The objective at the step is at most `ε` above its value at every point of `K`. -/
  le_add : ∀ b ∈ K, η * y x + bregDiv F x a F' ≤ η * y b + bregDiv F b a F' + ε

